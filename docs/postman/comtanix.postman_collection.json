          "response": []
        },
        {
          "name": "Send signed event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"event_id\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.environment.set(\"occurred_at\", new Date().toISOString());",
                  "",
                  "// sign the exact body that will be sent, like the Laravel job does",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const signature = CryptoJS.HmacSHA256(body, pm.environment.get(\"audit_secret\")).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Signature\", value: signature });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"type\": \"quote_request.status_changed\",\n  \"quoteRequestId\": {{quote_request_id}},\n  \"actorId\": 1,\n  \"data\": {\n    \"from\": \"new\",\n    \"to\": \"in_review\"\n  },\n  \"occurredAt\": \"{{occurred_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{audit_url}}/events",
              "host": [
                "{{audit_url}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "Creates a new event. The pre-request script generates the eventId and signs the raw body with audit_secret (must match AUDIT_SECRET in audit-service/.env). Expect 201."
          },
          "response": []
        },
        {
          "name": "Send the same event again",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// reuses the event_id from \"Send signed event\", so the service should answer \"Event already recorded.\"",
                  "",
                  "// sign the exact body that will be sent, like the Laravel job does",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "const signature = CryptoJS.HmacSHA256(body, pm.environment.get(\"audit_secret\")).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: \"X-Signature\", value: signature });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"type\": \"quote_request.status_changed\",\n  \"quoteRequestId\": {{quote_request_id}},\n  \"actorId\": 1,\n  \"data\": {\n    \"from\": \"new\",\n    \"to\": \"in_review\"\n  },\n  \"occurredAt\": \"{{occurred_at}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{audit_url}}/events",
              "host": [
                "{{audit_url}}"
              ],
              "path": [
                "events"
              ]
            },
            "description": "Sends the previous event again. Expect 200 \"Event already recorded.\" and still only one copy stored."
          },
          "response": []
        },
